{
  "name": "Roblox Game",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "IntroCamera": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "CanTouch": false,
          "CanQuery": false,
          "Transparency": 0.35
        }
      },
      "IntroCameraTarget": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": false,
          "CanTouch": false,
          "CanQuery": false,
          "Transparency": 0.35
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "MenuRigKeeper": {
        "$path": "src/server/MenuRigKeeper.server.luau"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "CinematicIntro": {
          "$path": "src/client/CinematicIntro.client.luau"
        }
      }
    }
  }
}
